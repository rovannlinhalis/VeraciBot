@page "/me"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VeraciBot.App.Data

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<PageTitle>Meu Painel</PageTitle>

<h1>Meu Painel</h1>

@if (isLoading)
{
    <p>Carregando...</p>
}
else if (currentUser is null)
{
    <div class="alert alert-warning" role="alert">
        Nao foi possivel carregar o usuario atual.
    </div>
}
else
{
    <section class="border rounded p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h2 class="h5 mb-1">@FormatUserTitle()</h2>
                <div class="text-muted small">@currentUser.Email</div>
                <div class="text-muted small">AuthorId: @FormatText(authorId)</div>
            </div>
            <span class="badge @GetStatusBadgeClass()">@GetStatusLabel()</span>
        </div>

        @if (string.IsNullOrWhiteSpace(authorId))
        {
            <div class="alert alert-info mt-3 mb-0" role="alert">
                Cadastre seu @@ do Twitter em <a href="Account/Manage">Minha conta</a> para vincular sua atividade do bot a este usuario.
            </div>
        }
    </section>

    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-2">
            <section class="border rounded p-3 h-100">
                <div class="text-muted small">Pontuacao</div>
                <div class="fs-4 fw-semibold">@score.Score</div>
                <div class="text-muted small mt-2">Ranking #@rankingPosition</div>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="border rounded p-3 h-100">
                <div class="text-muted small">Vitorias</div>
                <div class="fs-4 fw-semibold">@score.Wins</div>
                <div class="text-muted small mt-2">@score.Losses derrotas</div>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="border rounded p-3 h-100">
                <div class="text-muted small">Saldo convites</div>
                <div class="fs-4 fw-semibold">@score.InviteCredits</div>
                <div class="text-muted small mt-2">Disponiveis para convidar</div>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="border rounded p-3 h-100">
                <div class="text-muted small">Convidados</div>
                <div class="fs-4 fw-semibold">@score.InvitesAccepted</div>
                <div class="text-muted small mt-2">@score.InvitesSent enviados, @pendingInvites pendentes</div>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="border rounded p-3 h-100">
                <div class="text-muted small">Mencoes</div>
                <div class="fs-4 fw-semibold">@activity.Count</div>
                <div class="text-muted small mt-2">Ultimos 90 dias</div>
            </section>
        </div>
        <div class="col-6 col-xl-2">
            <section class="border rounded p-3 h-100">
                <div class="text-muted small">Ultima atividade</div>
                <div class="fs-6 fw-semibold">@FormatDate(lastActivityUtc)</div>
                <div class="text-muted small mt-2">No Twitter/X</div>
            </section>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-5">
            <section class="border rounded p-3 h-100">
                <h2 class="h5">Minhas interacoes</h2>
                @if (actionStats.Count == 0)
                {
                    <p class="text-muted mb-0">Nenhuma atividade registrada.</p>
                }
                else
                {
                    @foreach (var item in actionStats)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center small mb-1">
                                <span>@item.Label</span>
                                <strong>@item.Count</strong>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar"
                                     role="progressbar"
                                     style="width: @GetPercent(item.Count, maxActionCount)%"
                                     aria-valuenow="@GetPercent(item.Count, maxActionCount)"
                                     aria-valuemin="0"
                                     aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                }
            </section>
        </div>

        <div class="col-xl-7">
            <section class="border rounded p-3 h-100">
                <h2 class="h5">Atividade recente</h2>
                @if (activity.Count == 0)
                {
                    <p class="text-muted mb-0">Nenhuma mencao processada para este usuario.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Quando</th>
                                    <th>Acao</th>
                                    <th>Mencao</th>
                                    <th>Link</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in activity.Take(20))
                                {
                                    <tr>
                                        <td class="text-nowrap">@FormatDate(item.ProcessedAtUtc)</td>
                                        <td>
                                            <span class="badge text-bg-secondary">@GetResultLabel(item.Result)</span>
                                        </td>
                                        <td class="text-break">@FormatMentionText(item.Text)</td>
                                        <td class="text-nowrap"><a href="@GetMentionUrl(item)" target="_blank" rel="noopener noreferrer">Abrir</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    </div>
}

@code {
    private readonly List<ProcessedMention> activity = [];
    private readonly List<ActionStat> actionStats = [];

    private ApplicationUser currentUser;
    private AuthorizedTwitterUser score;
    private bool isLoading = true;
    private string authorId = string.Empty;
    private int rankingPosition = 0;
    private int maxActionCount = 1;
    private int pendingInvites = 0;
    private DateTimeOffset? lastActivityUtc;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = await UserManager.GetUserAsync(authState.User);

        if (currentUser is null)
        {
            isLoading = false;
            return;
        }

        await LoadUserDataAsync();
        isLoading = false;
    }

    private async Task LoadUserDataAsync()
    {
        authorId = currentUser.AuthorId?.Trim() ?? string.Empty;
        score = null;

        if (!string.IsNullOrWhiteSpace(authorId))
        {
            score = await DbContext.AuthorizedTwitterUsers
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.AuthorId == authorId);
        }

        if (score is null && !string.IsNullOrWhiteSpace(currentUser.TwitterUsername))
        {
            var username = currentUser.TwitterUsername.Trim().TrimStart('@');
            score = await DbContext.AuthorizedTwitterUsers
                .AsNoTracking()
                .FirstOrDefaultAsync(x => x.Username == username);

            if (score is not null)
                authorId = score.AuthorId;
        }

        score ??= new AuthorizedTwitterUser
        {
            AuthorId = authorId,
            Username = currentUser.TwitterUsername ?? string.Empty,
            Status = AuthorizedTwitterUser.STATUS_NOT_AUTHORIZED
        };

        if (!string.IsNullOrWhiteSpace(authorId))
        {
            var fromUtc = DateTimeOffset.UtcNow.AddDays(-90);
            activity.Clear();
            activity.AddRange(await DbContext.ProcessedMentions
                .AsNoTracking()
                .Where(x => x.AuthorId == authorId && x.ProcessedAtUtc >= fromUtc)
                .OrderByDescending(x => x.ProcessedAtUtc)
                .Take(200)
                .ToListAsync());

            pendingInvites = await DbContext.TwitterInvites
                .AsNoTracking()
                .CountAsync(x => x.InviterAuthorId == authorId && x.Status == TwitterInvite.STATUS_PENDING);

            lastActivityUtc = activity.Count == 0 ? null : activity.Max(x => x.ProcessedAtUtc);
        }
        else
        {
            pendingInvites = 0;
        }

        await LoadRankingPositionAsync();
        BuildActionStats();
    }

    private async Task LoadRankingPositionAsync()
    {
        if (string.IsNullOrWhiteSpace(score.AuthorId))
        {
            rankingPosition = 0;
            return;
        }

        rankingPosition = await DbContext.AuthorizedTwitterUsers
            .AsNoTracking()
            .CountAsync(x => x.Score > score.Score);
        rankingPosition++;
    }

    private void BuildActionStats()
    {
        actionStats.Clear();
        actionStats.AddRange(activity
            .GroupBy(x => NormalizeResult(x.Result))
            .Select(x => new ActionStat(x.Key, GetResultLabel(x.Key), x.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Label));

        maxActionCount = Math.Max(1, actionStats.Count == 0 ? 1 : actionStats.Max(x => x.Count));
    }

    private string FormatUserTitle()
    {
        if (!string.IsNullOrWhiteSpace(score?.Username))
            return "@" + score.Username;

        if (!string.IsNullOrWhiteSpace(currentUser?.TwitterUsername))
            return "@" + currentUser.TwitterUsername.Trim().TrimStart('@');

        return currentUser?.UserName ?? "Usuario";
    }

    private string GetStatusLabel()
    {
        return score?.Status switch
        {
            AuthorizedTwitterUser.STATUS_AUTHORIZED => "Permitido no bot",
            AuthorizedTwitterUser.STATUS_INVITED => "Convidado",
            AuthorizedTwitterUser.STATUS_NOT_AUTHORIZED => "Bloqueado no bot",
            _ => "Sem autorizacao"
        };
    }

    private string GetStatusBadgeClass()
    {
        return score?.Status switch
        {
            AuthorizedTwitterUser.STATUS_AUTHORIZED => "text-bg-success",
            AuthorizedTwitterUser.STATUS_INVITED => "text-bg-warning",
            AuthorizedTwitterUser.STATUS_NOT_AUTHORIZED => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }

    private static int GetPercent(int value, int max)
    {
        if (max <= 0)
            return 0;

        return Math.Clamp((int)Math.Round(value * 100d / max), 0, 100);
    }

    private static string FormatDate(DateTimeOffset? value)
    {
        return value.HasValue
            ? value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            : "-";
    }

    private static string FormatText(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatMentionText(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        return value.Length <= 160 ? value : value[..157] + "...";
    }

    private static string GetMentionUrl(ProcessedMention mention)
    {
        if (!string.IsNullOrWhiteSpace(mention.MentionUrl))
            return mention.MentionUrl;

        return string.IsNullOrWhiteSpace(mention.TweetId)
            ? "#"
            : $"https://x.com/i/web/status/{mention.TweetId.Trim()}";
    }

    private static string NormalizeResult(string result)
    {
        return string.IsNullOrWhiteSpace(result)
            ? "NO_AGENT_RESPONSE"
            : result.Trim().ToUpperInvariant();
    }

    private static string GetResultLabel(string result)
    {
        return NormalizeResult(result) switch
        {
            "HELP" => "Ajuda",
            "SCORE" => "Pontuacao",
            "SCOREBOARD" => "Placar",
            "INVITE" => "Convite",
            "INVITE_NO_USER" => "Convite sem usuario",
            "INVITE_ERROR" => "Erro de convite",
            "ACCEPT" => "Aceite",
            "REFUSE" => "Recusa",
            "UNKNOWN" => "Comando desconhecido",
            "NOT_AUTHORIZED" => "Nao autorizado",
            "THREAD_ARGUE_0" => "Debate empatado",
            "THREAD_ARGUE_1" => "Debate: autor A",
            "THREAD_ARGUE_2" => "Debate: autor B",
            "THREAD_FACT_TRUE" => "Checagem: verdadeiro",
            "THREAD_FACT_FALSE" => "Checagem: falso",
            "THREAD_FACT_UNCERTAIN" => "Checagem: inconclusivo",
            "THREAD_WHOISRIGHT" => "Quem tem razao",
            "NEWS_SEARCH" => "Pesquisa de noticia",
            "NEWS_SEARCH_EMPTY" => "Pesquisa sem resultados",
            "NEWS_SEARCH_ERROR" => "Erro em pesquisa",
            _ => NormalizeResult(result).Replace('_', ' ').ToLowerInvariant()
        };
    }

    private sealed record ActionStat(string Result, string Label, int Count);
}
